{
  "manifest_version": 3,
  "name": "Eitri CMS Publisher",
  "version": "1.2.1",
  "description": "Aplica um JSON de sections (REPLACE ou ADD) direto na página do editor VTEX CMS aberta na aba atual.",
  "action": {
    "default_title": "Eitri CMS Publisher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs", "storage", "scripting", "sidePanel"],
  "host_permissions": [
    "*://*.myvtex.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.myvtex.com/admin/*"],
      "js": ["src/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
